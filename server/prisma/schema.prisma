// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  phone     String?
  avatarUrl String?
  /// Shown to buyers as a "Verified" badge. Only an admin approving a verification
  /// request sets this — it is a claim about a real licence, not a self-assigned flag.
  ///
  /// Deliberately NOT reused for email verification. Confirming you can read your own
  /// inbox says nothing about being a licensed broker, and letting it set this flag
  /// would hand the badge to anyone who clicks a link.
  isVerified Boolean  @default(false)

  /// When this address was confirmed with an emailed code. Null means unconfirmed,
  /// which today is shown in Settings but blocks nothing.
  emailVerifiedAt DateTime?

  /// 'agent' for everyone who signs up; 'admin' for staff. Deliberately not settable
  /// through any API — an account is promoted with the seed script, so there is no
  /// route an attacker could aim at to escalate.
  role      String    @default("agent")

  /// Set when staff suspend the account. Checked on every authenticated request, so a
  /// suspension takes effect on the next call rather than whenever the token expires.
  suspendedAt DateTime?
  /// Shown to the user on their way out, and to staff reviewing the decision later.
  suspendedReason String?
  /// When the suspension lifts by itself. Null means indefinite — it ends only when
  /// staff restore the account.
  ///
  /// Nothing sweeps this on a timer. It is compared against the clock wherever a
  /// suspension is checked, and cleared there when it has passed, so an account comes
  /// back the moment its owner next tries to use it. A scheduled job would be a second
  /// mechanism that could disagree with the first, and would restore accounts nobody
  /// was asking about.
  suspendedUntil DateTime?

  // In-app notification preferences. Default on so the app feels alive for new
  // users, and each can be switched off independently from Settings.
  notifyNewListings Boolean @default(true)
  notifyNewReels    Boolean @default(true)
  notifyMyActivity  Boolean @default(true)
  /// Email me when a message arrives while I am offline. Separate from the in-app
  /// switches above because it leaves the app and lands in someone inbox.
  notifyEmailMessages Boolean @default(true)

  /// Send a holding reply to buyers who message while I am offline.
  ///
  /// On by default: a buyer who hears nothing for a night usually goes elsewhere, and
  /// an agent who does not want it can switch it off in Settings. Only ever states
  /// facts already on the listing, and is labelled as automatic wherever it appears.
  autoReplyEnabled Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Set on every socket connect and disconnect, for "Active 12m ago".
  lastSeenAt DateTime?

  /// When the user closed the feedback prompt without answering. We ask once, after
  /// their first finished reel, and never again — this is what makes "never again"
  /// hold across devices, which a flag in the browser would not.
  feedbackDismissedAt DateTime?

  listings  Listing[]
  messages  Message[]
  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  notifications Notification[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens RefreshToken[]
  reelRenders ReelRender[]
  listingViews ListingView[]
  verificationRequests VerificationRequest[]
  emailCodes EmailVerificationCode[]
  reels     Reel[]
  chatMessages ChatMessage[]
  feedback  Feedback?
}

/// What an agent thinks of Reelink, asked once and shown on the landing page.
///
/// The rating is about the product, not about the listing or reel that prompted it —
/// that is what makes an entry usable as a testimonial rather than as a review of a
/// property.
model Feedback {
  id        String   @id @default(uuid())
  /// One per agent: we ask once, so a second row would mean something went wrong.
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 1-5. Every rating is kept, including the unhappy ones — they are the useful
  /// ones — but only 4 and 5 are eligible to be shown publicly.
  rating    Int
  /// Optional to give, required to publish. A wall of bare stars persuades nobody,
  /// so an entry with no words stays private however high the rating.
  comment   String?

  /// Which moment prompted it, so feedback on the reel flow can be told apart from
  /// feedback on listings later, without asking the user twice.
  source    String

  /// Consent to show their name and photo, asked in the modal and defaulted on.
  /// Without it the entry can still be published, but reads as anonymous.
  showName  Boolean  @default(true)

  /// Whether it is on the landing page right now. Set automatically on submit when
  /// the rating is high and there are words to show; an admin can turn it off again.
  published Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The landing page asks for published entries newest first, and nothing else.
  @@index([published, createdAt])
}

/// One continuous Amicus AI conversation per user, kept so advice survives a refresh.
model ChatMessage {
  id        String   @id @default(uuid())
  role      String   // 'user' | 'assistant'
  content   String
  imageUrls String[] // photos the user attached to this message
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A single-use password reset link.
///
/// Only a hash of the token is stored: the raw value goes out in the email and is
/// never written down, so a leaked database cannot be used to reset anyone's password.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A long-lived credential that buys short-lived access tokens.
///
/// Access tokens are JWTs — self-contained, so the server cannot take one back once
/// issued. That is why they now last an hour instead of a week: the damage window of a
/// stolen one is bounded by its own expiry. Revocation lives here instead, because a
/// row can be deleted. Signing out, or a refresh token being replayed, kills the
/// session for real.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  /// Set when this token is spent. A spent token that comes back is a replay.
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  /// What this notification is about, so tapping it can open the thing itself: a
  /// conversation id for 'message', a listing id for 'listing', a reel id for 'reel'.
  /// Nullable because older rows predate it and because the target can be deleted —
  /// the client falls back to the relevant tab when it is missing.
  entityId  String?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Listing {
  id             String    @id @default(uuid())
  title          String
  description    String?
  price          Float
  lotArea        Float?
  floorArea      Float?
  amenities      String[]
  status         String
  listingType    String    @default("sale")
  latitude       Float?
  longitude      Float?
  photoUrls      String[]
  // Optional 360 shots that power the virtual tour. Separate from photoUrls because
  // they are a different kind of image and are validated as panorama-shaped.
  panoramaUrls   String[]
  // Room name per panorama, written by the vision model in the background after
  // upload. Empty until that finishes, or if it fails.
  panoramaLabels String[]
  publishToFacebook Boolean @default(false)
  facebookPostId String?

  /// What the automated check made of this listing.
  ///
  /// 'ok'       — passed, or never checked (the model was unavailable). Visible.
  /// 'flagged'  — the check did not think this is a property. Hidden from Browse,
  ///              still visible to its owner and to staff.
  /// 'appealed' — the agent disputes the flag and has asked for a human to look.
  ///              Still hidden; the difference is that it is now in the queue.
  /// 'cleared'  — staff looked and disagreed with the check. Visible, and never
  ///              re-checked, so an edit cannot flag it a second time.
  ///
  /// Defaults to 'ok' rather than 'pending' on purpose: the check runs after the row
  /// is written, and a listing must never be invisible because a background job has
  /// not got to it yet.
  moderationStatus String  @default("ok")
  /// The model's own words for why, shown to the agent and to staff.
  moderationReason String?
  /// What the agent said when disputing it.
  moderationNote   String?
  moderatedAt      DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  leads          Lead[]
  views          ListingView[]
  conversations  Conversation[]
  reels          Reel[]
}
model Reel {
  id         String   @id @default(uuid())
  videoUrl   String?
  status     String   @default("pending")
  /// The AI headline burned into the video, kept so it can be copied as a caption.
  hook       String?
  /// Which visual template this reel was rendered with.
  template   String   @default("classic")
  createdAt  DateTime @default(now())

  // Populated only for reels created through the AI quick-create flow, which renders
  // from photos and details typed in directly instead of from a saved listing.
  title          String?
  price          Float?
  propertyStatus String?
  listingType    String?
  amenities      String[]
  photoUrls      String[]

  /// Same states and meanings as Listing.moderationStatus.
  ///
  /// Only quick reels are ever checked. A reel made from a saved listing inherits
  /// that listing's photos, which were already examined when it was created — running
  /// the model over the same images again would cost a call to reach the same answer.
  moderationStatus String  @default("ok")
  moderationReason String?
  moderationNote   String?
  moderatedAt      DateTime?

  // Reels are owned directly, since a standalone reel has no listing to inherit from.
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  listingId  String?
  listing    Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

/// One row per render *attempt*, which is what the quota actually counts.
///
/// Counting Reel rows would not work: regenerating reuses the existing reel instead
/// of creating a new one, so a user could re-render the same reel endlessly and never
/// reach the cap. Keeping it in the database rather than in the rate limiter's memory
/// also means a server restart doesn't hand everyone a fresh allowance.
model ReelRender {
  id        String   @id @default(uuid())
  /// Null once the reel is deleted; the attempt still counts toward that day.
  reelId    String?
  createdAt DateTime @default(now())

  /// Whether this attempt paid for an AI-generated opening clip. Free Remotion renders
  /// and billed Higgsfield ones share a table but not an allowance — the cheap one is
  /// capped for fairness, the expensive one for cost.
  usedAi    Boolean  @default(false)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A one-time code emailed to confirm an address.
///
/// Codes are not unique across users, and deliberately so. A code is only ever checked
/// together with the account that asked for it, so two people holding 481923 can never
/// use each other's. Forcing global uniqueness on a six-digit space would cap the
/// platform at a million pending verifications and would leak which codes are live —
/// a rejected code would tell an attacker it belongs to somebody.
///
/// What actually protects the account is here instead: a short expiry, a hard attempt
/// limit, and only one live code per user at a time.
model EmailVerificationCode {
  id         String    @id @default(uuid())
  /// SHA-256 of the six digits. A six-digit space is small enough to reverse offline,
  /// so this is not the defence — it just keeps the plain code out of backups and logs.
  codeHash   String
  /// The address the code was sent to. Checked on redemption, so a code stops working
  /// if the user changes their email before entering it.
  email      String
  expiresAt  DateTime
  /// Counts wrong guesses. At the limit the code is dead and a new one must be sent,
  /// which is what makes six digits safe rather than merely long.
  attempts   Int       @default(0)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// An agent asking to be verified as a real, licensed broker or salesperson.
///
/// Verification has to be *reviewed*, not toggled: the badge tells a buyer this person
/// is who they claim to be, so there is a submission with evidence behind every
/// approval. In the Philippines that is a PRC licence number for brokers and
/// salespersons, optionally backed by a photo of the licence or ID.
model VerificationRequest {
  id             String    @id @default(uuid())
  /// PRC licence or DHSUD registration number, as typed by the agent.
  licenseNumber  String
  /// Optional photo of the licence. Not required, so an agent is never blocked from
  /// asking, but staff can decline without one.
  documentUrl    String?
  /// 'pending' | 'approved' | 'rejected'
  status         String    @default("pending")
  /// Why it was declined, shown back to the agent so they can correct and resubmit.
  reviewNote     String?
  reviewedAt     DateTime?
  reviewedById   String?
  createdAt      DateTime  @default(now())

  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

/// One recorded look at a listing's detail page.
///
/// Rows rather than a counter column: a single number can only ever say "241 views",
/// while timestamps can answer "is this listing picking up or going quiet?", which is
/// the question an agent actually has. Deliberately thin — no IP, no user agent, no
/// referrer; the dashboard needs a trend line, not a surveillance log.
model ListingView {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// Null for signed-out visitors. Used only to keep one person refreshing a page from
  /// counting as twenty views.
  viewerId  String?
  viewer    User?    @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([listingId, createdAt])
  @@index([viewerId, listingId, createdAt])
}

model Lead {
  id          String   @id @default(uuid())
  source      String
  name        String?
  contact     String?
  commentText String?
  createdAt   DateTime @default(now())

  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

/// One buyer talking to one seller about one property. Scoped to the listing so an
/// agent with several units can tell the enquiries apart.
model Conversation {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())
  /// Bumped on every message, so the inbox can sort by recent activity cheaply.
  lastMessageAt DateTime  @default(now())

  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  buyerId       String
  buyer         User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)

  sellerId      String
  seller        User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)

  messages      Message[]

  /// When each side removed this thread from their own inbox.
  ///
  /// Per-side rather than a single flag, because one row is shared by two people: a
  /// hard delete would take the other party's copy and their message history with it,
  /// which is not what "delete" means in any messaging app. Hiding is also reversible —
  /// a new message clears the stamp and the thread returns, carrying only what was said
  /// after it was cleared.
  buyerDeletedAt  DateTime?
  sellerDeletedAt DateTime?

  /// Reopening the same property with the same person continues the thread instead
  /// of starting a second one.
  @@unique([listingId, buyerId, sellerId])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(uuid())
  content        String
  createdAt      DateTime     @default(now())
  /// Set when the recipient's app acknowledges receipt — not when we merely think
  /// they are online, so a message lost to a dropped socket never shows "Delivered".
  deliveredAt    DateTime?
  /// Null until the other party opens the thread; drives the unread count and ticks.
  readAt         DateTime?

  /// Written by the auto-responder rather than typed by the agent.
  ///
  /// senderId is still the agent, because the thread has exactly two participants and
  /// inventing a third would complicate every query that reads it. This flag is what
  /// stops that being a lie: the client marks these visibly, and the text says so too.
  /// It also keeps the responder from answering itself — an automated message never
  /// triggers another one.
  isAutomated    Boolean      @default(false)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}