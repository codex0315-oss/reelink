# Copy to .env and fill in. Never commit the filled-in copy.

# ---------------------------------------------------------------- required

# PostgreSQL. Locally this is your own instance; in production use a hosted one
# (Neon and Supabase both have free tiers).
DATABASE_URL=postgresql://postgres:password@localhost:5432/reelink-application

# Signs access tokens. Generate a long random string — anyone holding it can mint a
# token for any account:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Powers the AI description, the reel script and Amicus. Free tier at console.groq.com.
GROQ_API_KEY=

# ---------------------------------------------------------------- optional

# Where this API is reachable. Remotion's headless Chrome fetches listing photos back
# over HTTP while rendering, so in production this must be the public URL, not localhost.
SELF_URL=http://localhost:3000

# Browser origins allowed to call this API, comma separated.
CORS_ORIGINS=http://localhost:5173

# Set true only behind a reverse proxy (Render, Railway, nginx). It makes the rate
# limiter trust X-Forwarded-For, so leaving it on without a proxy lets anyone spoof
# their IP and bypass throttling.
TRUST_PROXY=false

# Transactional email — password resets and offline message alerts. Without one of
# these the app still runs; it just logs instead of sending.
BREVO_API_KEY=
BREVO_SMTP_KEY=
BREVO_SMTP_LOGIN=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
MAILERSEND_API_KEY=
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=Reelink

# AI-generated opening shot for reels. Billed per clip (~$0.41 on DoP Turbo), so the
# app caps it at 2 a day per account. Leave blank and reels render from stills.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_MODEL=higgsfield-ai/dop/turbo

# Render tuning. Lower REEL_SCALE to 0.667 for 720x1280 renders at roughly half the
# time; raise REEL_CONCURRENCY only if the box has RAM to spare — each parallel tab is
# a full Chrome renderer.
REEL_RENDERER=remotion
REEL_CONCURRENCY=1
REEL_SCALE=1
REEL_CRF=23

# Object storage for uploads (Supabase Storage, or any S3-compatible bucket).
#
# Leave all of these blank in development and uploads go to ./uploads on disk, which
# needs no account and no network. Set them in production: a container filesystem is
# wiped on every restart, so a photo written there survives only until the instance
# sleeps — which is exactly how listing photos and avatars were being lost.
#
# From Supabase: Project Settings -> Storage -> S3 connection gives the endpoint and
# region; "New access key" there gives the two credentials. The bucket must be created
# and marked public, since the public URL is what the browser loads images from.
#
#   S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
#   S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/reelink
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Where links inside emails point: password resets and new-message alerts. This is the
# React app, not this API — SELF_URL is the API. Falls back to the first CORS_ORIGINS
# entry when unset, so a deployment cannot silently email out localhost links.
APP_URL=http://localhost:5173
